{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Semantic Field",
  "description": "Graph of concepts, principles, SOPs, and references with epistemic status and evidence linkage.",
  "type": "object",
  "required": ["version", "source_file", "built_at", "nodes", "edges", "metadata"],
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0"
    },
    "source_file": {
      "type": "string",
      "description": "Name of the source file this semantic field was built from"
    },
    "source_sha256": {
      "type": "string",
      "description": "SHA-256 hash of the source file (optional, may be empty)"
    },
    "compiled_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp of when the source was compiled"
    },
    "built_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp of when this semantic field was built"
    },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/definitions/node" },
      "description": "All nodes in the semantic field graph"
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/definitions/edge" },
      "description": "All edges (relationships) between nodes"
    },
    "metadata": {
      "type": "object",
      "required": ["total_nodes", "total_edges", "node_counts", "edge_counts"],
      "properties": {
        "total_nodes": { "type": "integer", "minimum": 0 },
        "total_edges": { "type": "integer", "minimum": 0 },
        "node_counts": {
          "type": "object",
          "properties": {
            "concept": { "type": "integer", "minimum": 0 },
            "principle": { "type": "integer", "minimum": 0 },
            "sop": { "type": "integer", "minimum": 0 },
            "reference": { "type": "integer", "minimum": 0 }
          }
        },
        "edge_counts": { "type": "object" }
      }
    }
  },
  "definitions": {
    "node": {
      "type": "object",
      "required": ["id", "type", "source_file"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["concept", "principle", "sop", "reference"]
        },
        "source_file": { "type": "string" },
        "evidence_id": {
          "type": ["string", "null"],
          "description": "Reference to the source claim that grounds this node"
        },
        "epistemic_status": {
          "type": "string",
          "enum": ["certain", "probable", "speculative"],
          "description": "Confidence level of this knowledge node"
        },
        "term": { "type": "string", "description": "Concept term (concept nodes only)" },
        "definition": { "type": "string", "description": "Concept definition (concept nodes only)" },
        "statement": { "type": "string", "description": "Principle statement (principle nodes only)" },
        "name": { "type": "string", "description": "SOP or reference name" },
        "when_to_use": { "type": "string", "description": "Decision conditions (sop nodes only)" },
        "url": { "type": "string", "description": "Reference URL (reference nodes only)" }
      }
    },
    "edge": {
      "type": "object",
      "required": ["id", "type", "source", "target"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["used_in", "supports", "requires", "references"]
        },
        "source": { "type": "string", "description": "Source node ID" },
        "target": { "type": "string", "description": "Target node ID" },
        "evidence_id": {
          "type": ["string", "null"],
          "description": "Evidence grounding this relationship"
        }
      }
    }
  }
}
